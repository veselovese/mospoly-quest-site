# Скопируйте в .env.local и поменяйте под себя (.env.local не коммитится)

# Адрес API. По умолчанию /api на том же домене
# VITE_API_URL=/api

# Куда dev-сервер проксирует /api (npm run dev). По умолчанию http://localhost:8000
# VITE_API_PROXY=http://localhost:8000

# Мок бэкенда в localStorage вместо настоящего API
# VITE_API_MOCK=true
